{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "tsc --noEmit",
    "billing:sync": "tsx --env-file-if-exists=../apps/web/.env billing-sync.ts",
    "paystack:mock": "tsx --env-file-if-exists=../apps/web/.env paystack-mock.ts",
    "webhook:replay": "tsx --env-file-if-exists=../apps/web/.env webhook-replay.ts",
    "payloads:redact": "tsx --env-file-if-exists=../apps/web/.env redact-payloads.ts",
    "setup": "tsx setup.ts",
    "dev:all": "tsx dev.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@workspace/auth": "workspace:*",
    "@workspace/billing": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/email": "workspace:*",
    "drizzle-orm": "catalog:",
    "picocolors": "^1.1.1",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

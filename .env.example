# Copy to apps/web/.env and fill in. Placeholder values only.

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/turbo_start_paystack

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack. Test keys start with sk_test_ / pk_test_.
PAYSTACK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
# Only for local development with `pnpm paystack:mock`:
# PAYSTACK_API_URL=http://localhost:4010
# PAYSTACK_MOCK_PORT=4010
# PAYSTACK_MOCK_WEBHOOK_URL=http://localhost:3000/api/webhooks/paystack
PAYSTACK_WEBHOOK_IP_ALLOWLIST=false
# Header your platform's proxy puts the client IP in (right-most entry is
# used). Defaults to x-vercel-forwarded-for on Vercel, else x-forwarded-for.
# CLIENT_IP_HEADER=x-real-ip

# Billing. Generate the key with: openssl rand -hex 32
BILLING_ENCRYPTION_KEY=replace-with-64-hex-characters
BILLING_CURRENCY=NGN
BILLING_GRACE_DAYS=7
BILLING_TRIAL_MODE=card

# Bearer token for /api/cron/billing-reconcile. Generate with: openssl rand -hex 16
CRON_SECRET=replace-with-a-long-random-string

# Set by `pnpm e2e`, not by hand: multiplies the sign-in (and other auth)
# rate limits. Ignored in production and unless Paystack is the local mock.
# E2E_AUTH_RATE_LIMIT_SCALE=20

# Email. Without RESEND_API_KEY, emails are logged (development only).
EMAIL_FROM=Turbo Start <noreply@example.com>
RESEND_API_KEY=
# EMAIL_TRANSPORT=log
# Email branding (optional).
EMAIL_BRAND_NAME=Turbo Start
# EMAIL_LOGO_URL=https://example.com/logo.png
# EMAIL_SUPPORT_URL=mailto:support@example.com

# Invoices (optional). The seller printed on every invoice; empty fields are
# left off and the name falls back to EMAIL_BRAND_NAME. Each invoice keeps
# the details it was issued with, so changing these never edits old ones.
# INVOICE_SELLER_NAME=Turbo Start Ltd
# INVOICE_SELLER_ADDRESS=12 Admiralty Way\nLekki Phase 1\nLagos, Nigeria
# INVOICE_SELLER_EMAIL=billing@example.com
# INVOICE_SELLER_TAX_ID=RC 1234567
# INVOICE_SELLER_VAT_NUMBER=12345678-0001
# VAT included in your prices, in percent (Nigeria: 7.5). 0 or unset prints
# no VAT lines; when set, invoices show net, VAT and total.
# INVOICE_VAT_RATE=7.5
